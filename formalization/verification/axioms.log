  (D : Fin m → Matrix (Fin n) (Fin r) ℝ) (K : Matrix ρ (Fin n) ℝ) (N : Matrix ρ α ℝ) (v : Fin n → ℝ)
  (a : Fin m × Fin n ⊕ Fin m × α ⊕ α → ℝ),
