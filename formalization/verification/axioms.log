        (fun p => ((K.mulVec fun i => a (Sum.inl (p.1, i))) + N.mulVec fun i => a (Sum.inr (Sum.inl (p.1, i)))) p.2)
        (K.mulVec (A.transpose.mulVec v + ∑ j, (C j).transpose.mulVec fun i => a (Sum.inl (j, i))) +
