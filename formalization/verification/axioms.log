  [inst : Fintype ι] {μ : MeasureTheory.Measure Ω} [inst_1 : MeasureTheory.IsProbabilityMeasure μ]
  {𝓕 : MeasureTheory.Filtration NNReal mΩ} {W : ι → NNReal → Ω → ℝ} {B : NNReal → Ω → ℝ}
  [inst_2 : ∀ (i : ι), LinearStochastic.CommonItoIsometry.ForwardIndependent (W i) 𝓕 μ]
  [LinearStochastic.CommonItoIsometry.ForwardIndependent B 𝓕 μ]
  (hW : ∀ (i : ι), ProbabilityTheory.IsPreBrownianReal (W i) μ) (hWm : ∀ (i : ι) (t : NNReal), Measurable (W i t)),
