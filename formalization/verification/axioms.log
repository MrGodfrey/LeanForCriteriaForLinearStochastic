                ∫ (s : ℝ) in Set.Ioc 0 ↑T,
                  ∫ (ω : Ω),
                    inner ℝ ((∫ (t : ℝ) in Set.Ioc 0 s, ↑↑f (t.toNNReal, ω)) + M s.toNNReal ω) (↑↑g (s.toNNReal, ω)) ∂P
