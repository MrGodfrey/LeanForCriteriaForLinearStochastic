  {μ : MeasureTheory.Measure Ω} [inst : MeasureTheory.IsProbabilityMeasure μ] {n r m : ℕ} [inst_1 : Nonempty (Fin n)]
  {W : Fin m → NNReal → Ω → ℝ} {𝓕 : MeasureTheory.Filtration NNReal mΩ} [𝓕.IsComplete μ]
  [inst_3 : ∀ (i : Fin m), LinearStochastic.CommonItoIsometry.ForwardIndependent (W i) 𝓕 μ]
  (hW : ∀ (i : Fin m), ProbabilityTheory.IsBrownianReal (W i) μ) (hWm : ∀ (i : Fin m) (t : NNReal), Measurable (W i t))
  (i₀ : Fin m),
  (∀ (i j : Fin m), LinearStochastic.CommonItoCross.PairForwardIndependent (W i) (W j) 𝓕 μ) →
    (∀ (i j : Fin m), i ≠ j → ProbabilityTheory.IndepFun (fun ω t => W i t ω) (fun ω t => W j t ω) μ) →
      ∀ (T : NNReal) (ρ : ℝ),
        0 < ρ →
          ∀ (A : Matrix (Fin n) (Fin n) ℝ) (B : Matrix (Fin n) (Fin r) ℝ) (C : Fin m → Matrix (Fin n) (Fin n) ℝ)
            (D : Fin m → Matrix (Fin n) (Fin r) ℝ) (P : Matrix (Fin n) (Fin n) ℝ) (U : Matrix (Fin r) (Fin n) ℝ)
            (hP : P.PosDef),
            (-LinearStochastic.LMIMatrixCoordinates.matrixLMI A B C D ρ P U).PosDef →
              ∀ (ξ : Ω → EuclideanSpace ℝ (Fin n)),
                MeasureTheory.MemLp ξ 2 μ →
                  MeasureTheory.StronglyMeasurable ξ →
                    ∃ X R,
                      MeasureTheory.IsStronglyProgressive 𝓕 R ∧
                        (∀ᵐ (ω : Ω) ∂μ, ContinuousOn (fun t => R t ω) (Set.Iic T)) ∧
                          MeasureTheory.MemLp (LinearStochastic.ContinuousDoobL2.pathSup R T) 2 μ ∧
                            ↑↑X =ᵐ[(LinearStochastic.CommonItoCLM.timeMeasure_T T).prod μ] Function.uncurry R ∧
                              R 0 =ᵐ[μ] ξ ∧
                                LinearStochastic.SectionLinearDuality.SectionIntegralSolution
                                    (EuclideanSpace.basisFun (Fin n) ℝ) ⋯ hWm T ξ
                                    ((LinearMap.toContinuousLinearMap (Matrix.toEuclideanLin A)).compLp X +
                                      (LinearMap.toContinuousLinearMap (Matrix.toEuclideanLin B)).compLp
                                        ((LinearMap.toContinuousLinearMap (Matrix.toEuclideanLin (U * P⁻¹))).compLp X))
                                    (fun i =>
                                      (LinearMap.toContinuousLinearMap (Matrix.toEuclideanLin (C i))).compLp X +
                                        (LinearMap.toContinuousLinearMap (Matrix.toEuclideanLin (D i))).compLp
                                          ((LinearMap.toContinuousLinearMap (Matrix.toEuclideanLin (U * P⁻¹))).compLp
                                            X))
                                    X (R T) ∧
                                  (∀ t ≤ T,
                                      R t =ᵐ[μ]
                                        LinearStochastic.LinearDuality.integralState (EuclideanSpace.basisFun (Fin n) ℝ)
                                          ⋯ hWm T ξ
                                          ((LinearMap.toContinuousLinearMap
                                                (Matrix.toEuclideanLin (A + B * (U * P⁻¹)))).compLp
                                            X)
                                          (fun i =>
                                            (LinearMap.toContinuousLinearMap
                                                  (Matrix.toEuclideanLin (C i + D i * (U * P⁻¹)))).compLp
                                              X)
                                          ↑t) ∧
                                    (∀ t ≤ T,
                                        ∫ (ω : Ω), ‖R t ω‖ ^ 2 ∂μ ≤
                                          LinearStochastic.MatrixGrowthBounds.conditionNumber P ⋯ * Real.exp (-ρ * ↑t) *
                                            ∫ (ω : Ω), ‖ξ ω‖ ^ 2 ∂μ) ∧
                                      ‖(LinearMap.toContinuousLinearMap (Matrix.toEuclideanLin (U * P⁻¹))).compLp X‖ ^
                                          2 ≤
                                        ‖LinearMap.toContinuousLinearMap (Matrix.toEuclideanLin (U * P⁻¹))‖ ^ 2 *
                                          ((LinearStochastic.MatrixGrowthBounds.conditionNumber P ⋯ *
                                              ∫ (ω : Ω), ‖ξ ω‖ ^ 2 ∂μ) /
                                            ρ)
