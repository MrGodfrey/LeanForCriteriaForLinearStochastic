import MathFin.Foundations.BrownianCylinderGeneration

/-!
The actual joint natural filtration and its finite dyadic coordinate cylinders.
The countable-generation identity is derived from continuity of each supplied
coordinate, without replacing the sample space by a canonical model.
-/
noncomputable section
namespace LinearStochastic.JointCylinderGeneration
open MeasureTheory Filter
open scoped NNReal Topology
variable {Ω ι : Type*} [mΩ : MeasurableSpace Ω]
  (W : ι → ℝ≥0 → Ω → ℝ) (hWm : ∀ i t, Measurable (W i t))

def natural : Filtration ℝ≥0 mΩ where
  seq t := ⨆ i, MathFin.ItoIntegralL2.natFiltration (hWm i) t
  mono' s t h := iSup_mono fun i => (MathFin.ItoIntegralL2.natFiltration (hWm i)).mono h
  le' t := iSup_le fun i => (MathFin.ItoIntegralL2.natFiltration (hWm i)).le t

theorem natural_eq (T : ℝ≥0) : natural W hWm T =
    ⨆ i, ⨆ t : ℝ≥0, ⨆ (_ : t ≤ T), MeasurableSpace.comap (W i t) inferInstance := rfl

theorem measurable_natural (i : ι) {s T : ℝ≥0} (hs : s ≤ T) :
    Measurable[natural W hWm T] (W i s) := by
  apply Measurable.of_comap_le
  exact (le_iSup_of_le i (le_iSup_of_le s (le_iSup_of_le hs le_rfl)))

def cylinderSigma (T : ℝ≥0) (k : ℕ) : MeasurableSpace Ω :=
  ⨆ i, MathFin.cylinderSigma (W i) T k

def cylinders (T : ℝ≥0) : Filtration ℕ mΩ where
  seq k := cylinderSigma W T k
  mono' k l h := iSup_mono fun i => (MathFin.cylinderFiltration (W i) T (hWm i)).mono h
  le' k := iSup_le fun i => (MathFin.cylinderFiltration (W i) T (hWm i)).le k

/-- Every joint past is generated by an increasing sequence of finite coordinate
cylinders when the channel index is finite. The equality itself allows arbitrary
channel index, so no countability assumption is hidden in its proof. -/
theorem iSup_cylinders_eq_natural
    (hWc : ∀ i ω, Continuous fun t => W i t ω) (T : ℝ≥0) :
    (⨆ k : ℕ, cylinders W hWm T k) = natural W hWm T := by
  change (⨆ k : ℕ, ⨆ i, MathFin.cylinderSigma (W i) T k) =
    ⨆ i, MathFin.ItoIntegralL2.natFiltration (hWm i) T
  rw [iSup_comm]
  congr 1
  funext i
  exact MathFin.iSup_cylinderSigma_eq_natFiltration (hWm i) (hWc i) T

/-- The exact finite list of channel/time coordinates generating each cylinder. -/
theorem cylinderSigma_eq_coordinates (T : ℝ≥0) (k : ℕ) :
    cylinderSigma W T k = ⨆ q : ι × {t : ℝ≥0 // t ∈ MathFin.dyadicGrid T k},
      MeasurableSpace.comap (W q.1 q.2) inferInstance := by
  simp only [cylinderSigma, MathFin.cylinderSigma, iSup_prod, iSup_subtype]

end LinearStochastic.JointCylinderGeneration
