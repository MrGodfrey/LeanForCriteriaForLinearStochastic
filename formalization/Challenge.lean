module
public import Mathlib

/-!
# Independent stochastic controllability statement

Only Mathlib is imported. The definitions specify the matrix obstruction
as an explicit set recursion, the usual Brownian filtration, the standard
Itô integral by its elementary increment sums, and four SDE control properties.
The only deliberate proof holes are the two advertised theorems.
-/

@[expose] public section
noncomputable section
open MeasureTheory ProbabilityTheory Set
open scoped NNReal BigOperators InnerProductSpace

namespace LinearStochastic.Palomar

/-- The literal existential predecessor conditions on state vectors. -/
def obstruction {n r m : ℕ}
    (A : Matrix (Fin n) (Fin n) ℝ) (B : Matrix (Fin n) (Fin r) ℝ)
    (C : Fin m → Matrix (Fin n) (Fin n) ℝ) (D : Fin m → Matrix (Fin n) (Fin r) ℝ)
    (V : Set (Fin n → ℝ)) : Set (Fin n → ℝ) :=
  {v | v ∈ V ∧ ∃ w : Fin m → Fin n → ℝ,
    (∀ i, w i ∈ V) ∧ B.transpose.mulVec v + ∑ i, (D i).transpose.mulVec (w i) = 0 ∧
    A.transpose.mulVec v + ∑ i, (C i).transpose.mulVec (w i) ∈ V}

/-- V₀ is the whole state space and Vₖ₊₁ is its existential predecessor. -/
def flag {n r m : ℕ}
    (A : Matrix (Fin n) (Fin n) ℝ) (B : Matrix (Fin n) (Fin r) ℝ)
    (C : Fin m → Matrix (Fin n) (Fin n) ℝ) (D : Fin m → Matrix (Fin n) (Fin r) ℝ)
    (k : ℕ) : Set (Fin n → ℝ) :=
  Nat.rec Set.univ (fun _ V => obstruction A B C D V) k

/-- Vertically stack the original diffusion-control matrices. -/
def stack {n r m : ℕ} (D : Fin m → Matrix (Fin n) (Fin r) ℝ) :
    Matrix (Fin m × Fin n) (Fin r) ℝ := fun p j => D p.1 p.2 j

variable {Ω : Type*} [mΩ : MeasurableSpace Ω] {μ : Measure Ω}

/-- The natural filtration generated by every coordinate of the given process. -/
def natural {m : ℕ} (W : Fin m → ℝ≥0 → Ω → ℝ)
    (hWm : ∀ i t, Measurable (W i t)) : Filtration ℝ≥0 mΩ where
  seq T := ⨆ i, ⨆ t : ℝ≥0, ⨆ (_ : t ≤ T), MeasurableSpace.comap (W i t) inferInstance
  mono' s t h := iSup_mono fun i => iSup_mono fun u => iSup_mono' fun hu => ⟨hu.trans h, le_rfl⟩
  le' T := iSup_le fun i => iSup_le fun t => iSup_le fun _ => (hWm i t).comap_le

/-- The sigma algebra generated by ambient measurable null sets. -/
def nulls : MeasurableSpace Ω :=
  MeasurableSpace.generateFrom {s | MeasurableSet[mΩ] s ∧ μ s = 0}

theorem nulls_le : nulls (μ := μ) ≤ mΩ :=
  MeasurableSpace.generateFrom_le fun _ hs => hs.1

/-- Usual augmentation of the joint natural filtration on the original space. -/
def usual {m : ℕ} (W : Fin m → ℝ≥0 → Ω → ℝ)
    (hWm : ∀ i t, Measurable (W i t)) : Filtration ℝ≥0 mΩ :=
  (natural W hWm ⊔ Filtration.const ℝ≥0 (nulls (μ := μ)) nulls_le).rightCont

/-- Lebesgue time measure restricted to the finite horizon (0,T]. -/
def timeMeasure (T : ℝ≥0) : Measure ℝ≥0 :=
  (Measure.comap ((↑) : ℝ≥0 → ℝ) volume).restrict (Ioc 0 T)

theorem predictable_le (𝓕 : Filtration ℝ≥0 mΩ) :
    𝓕.predictable ≤ Prod.instMeasurableSpace := by
  unfold Filtration.predictable
  apply MeasurableSpace.generateFrom_le
  rintro s (⟨A, hA, rfl⟩ | ⟨i, A, hA, rfl⟩)
  · exact (measurableSet_singleton _).prod (𝓕.le _ _ hA)
  · exact measurableSet_Ioi.prod (𝓕.le _ _ hA)

/-- Product time/probability measure restricted to the predictable sigma algebra. -/
def spacetime (𝓕 : Filtration ℝ≥0 mΩ) (μ : Measure Ω) (T : ℝ≥0) :=
  ((timeMeasure T).prod μ).trim (predictable_le 𝓕)

/-- Bounded predictable step processes, with every interval inside [0,T]. -/
structure Step (𝓕 : Filtration ℝ≥0 mΩ) (T : ℝ≥0) where
  valueBot : Ω → ℝ
  value : ℝ≥0 × ℝ≥0 →₀ Ω → ℝ
  ordered : ∀ p ∈ value.support, p.1 ≤ p.2
  horizon : ∀ p ∈ value.support, p.2 ≤ T
  measurableBot : Measurable[𝓕 0] valueBot
  measurableValue : ∀ p ∈ value.support, Measurable[𝓕 p.1] (value p)
  boundedBot : ∃ K : ℝ, ∀ ω, ‖valueBot ω‖ ≤ K
  boundedValue : ∃ K : ℝ, ∀ p ∈ value.support, ∀ ω, ‖value p ω‖ ≤ K

/-- The literal finite sum representing a step process. -/
def Step.eval {𝓕 : Filtration ℝ≥0 mΩ} {T : ℝ≥0} (V : Step 𝓕 T)
    (t : ℝ≥0) (ω : Ω) : ℝ :=
  ({0} : Set ℝ≥0).indicator (fun _ => V.valueBot ω) t +
    V.value.sum fun p v => (Ioc p.1 p.2).indicator (fun _ => v ω) t

/-- The elementary Itô integral is the finite sum of adapted coefficients
times Brownian increments. A continuous linear map agreeing with these sums
on every step process is the standard L² Itô integral, by density. The
existence of representatives is included, so this condition is not vacuous. -/
def IsIto (𝓕 : Filtration ℝ≥0 mΩ) (W : ℝ≥0 → Ω → ℝ) (T : ℝ≥0)
    (I : Lp ℝ 2 (spacetime 𝓕 μ T) →L[ℝ] Lp ℝ 2 μ) : Prop :=
  ∀ V : Step 𝓕 T, ∃ f : Lp ℝ 2 (spacetime 𝓕 μ T),
    (f : ℝ≥0 × Ω → ℝ) =ᵐ[spacetime 𝓕 μ T] Function.uncurry V.eval ∧
    (I f : Ω → ℝ) =ᵐ[μ] fun ω =>
      V.value.sum fun p v => v ω * (W p.2 ω - W p.1 ω)

variable [IsProbabilityMeasure μ]

/-- The actual vector Itô process, using scalar terminal integrals and their
conditional expectations at t, reconstructed in the standard Euclidean basis. -/
def vectorIntegral {n m : ℕ} (𝓕 : Filtration ℝ≥0 mΩ) (T : ℝ≥0)
    (I : Fin m → Lp ℝ 2 (spacetime 𝓕 μ T) →L[ℝ] Lp ℝ 2 μ)
    (φ : Fin m → Lp (EuclideanSpace ℝ (Fin n)) 2 (spacetime 𝓕 μ T))
    (t : ℝ≥0) (ω : Ω) : EuclideanSpace ℝ (Fin n) :=
  ∑ a, (∑ i, μ[(I i ((innerSL ℝ (EuclideanSpace.basisFun (Fin n) ℝ a)).compLp
    (φ i)) : Ω → ℝ) | 𝓕 t] ω) • EuclideanSpace.basisFun (Fin n) ℝ a

/-- The real matrix acting on Euclidean state or control space. -/
def matrixMap {a b : ℕ} (M : Matrix (Fin a) (Fin b) ℝ) :
    EuclideanSpace ℝ (Fin b) →L[ℝ] EuclideanSpace ℝ (Fin a) :=
  M.toEuclideanLin.toContinuousLinearMap

/-- A controlled SDE solution with an ordinary progressive finite-energy
control, a continuous S² state, and predictable representatives of the literal
raw coefficients. The equation holds almost surely at each prescribed time. -/
structure Controlled {n r m : ℕ} (𝓕 : Filtration ℝ≥0 mΩ) (T : ℝ≥0)
    (I : Fin m → Lp ℝ 2 (spacetime 𝓕 μ T) →L[ℝ] Lp ℝ 2 μ)
    (A : Matrix (Fin n) (Fin n) ℝ) (B : Matrix (Fin n) (Fin r) ℝ)
    (C : Fin m → Matrix (Fin n) (Fin n) ℝ) (D : Fin m → Matrix (Fin n) (Fin r) ℝ)
    (v₀ : EuclideanSpace ℝ (Fin n))
    (v : ℝ≥0 → Ω → EuclideanSpace ℝ (Fin r))
    (R : ℝ≥0 → Ω → EuclideanSpace ℝ (Fin n))
    (u : Lp (EuclideanSpace ℝ (Fin r)) 2 (spacetime 𝓕 μ T))
    (X : Lp (EuclideanSpace ℝ (Fin n)) 2 (spacetime 𝓕 μ T)) : Prop where
  control_progressive : IsStronglyProgressive 𝓕 v
  control_memLp : MemLp (Function.uncurry v) 2 ((timeMeasure T).prod μ)
  progressive : IsStronglyProgressive 𝓕 R
  continuous : ∀ᵐ ω ∂μ, ContinuousOn (fun t => R t ω) (Iic T)
  squareSup : MemLp (fun ω => ⨆ t : Iic T, ‖R t.val ω‖) 2 μ
  control_rep : (u : ℝ≥0 × Ω → EuclideanSpace ℝ (Fin r)) =ᵐ[(timeMeasure T).prod μ] Function.uncurry v
  state_rep : (X : ℝ≥0 × Ω → EuclideanSpace ℝ (Fin n)) =ᵐ[(timeMeasure T).prod μ] Function.uncurry R
  equation : ∀ t, t ≤ T → R t =ᵐ[μ] fun ω =>
    (∫ s in Ioc 0 (t:ℝ), matrixMap A (R s.toNNReal ω) + matrixMap B (v s.toNNReal ω)) +
      (v₀ + vectorIntegral 𝓕 T I (fun i =>
        (matrixMap (C i)).compLp X + (matrixMap (D i)).compLp u) t ω)

section Properties
variable {n r m : ℕ} (𝓕 : Filtration ℝ≥0 mΩ) (T : ℝ≥0)
  (I : Fin m → Lp ℝ 2 (spacetime 𝓕 μ T) →L[ℝ] Lp ℝ 2 μ)
  (A : Matrix (Fin n) (Fin n) ℝ) (B : Matrix (Fin n) (Fin r) ℝ)
  (C : Fin m → Matrix (Fin n) (Fin n) ℝ) (D : Fin m → Matrix (Fin n) (Fin r) ℝ)

/-- Reach a target to within an expected squared error ε. -/
def ReachApprox (v₀ : EuclideanSpace ℝ (Fin n)) (η : Lp (EuclideanSpace ℝ (Fin n)) 2 μ) (ε : ℝ) : Prop :=
  ∃ v R u X, Controlled 𝓕 T I A B C D v₀ v R u X ∧ (∫ ω, ‖R T ω - η ω‖^2 ∂μ) < ε

/-- Reach a target with almost-sure terminal equality. -/
def ReachExact (v₀ : EuclideanSpace ℝ (Fin n)) (η : Lp (EuclideanSpace ℝ (Fin n)) 2 μ) : Prop :=
  ∃ v R u X, Controlled 𝓕 T I A B C D v₀ v R u X ∧ R T =ᵐ[μ] η

/-- Approximate controllability to every square-integrable terminal target. -/
def AC : Prop := ∀ (v₀ : EuclideanSpace ℝ (Fin n)) (η : Lp (EuclideanSpace ℝ (Fin n)) 2 μ),
  AEStronglyMeasurable[𝓕 T] η μ →
  ∀ ε : ℝ, 0 < ε → ReachApprox 𝓕 T I A B C D v₀ η ε

/-- Approximate null controllability from every deterministic initial state. -/
def ANC : Prop := ∀ (v₀ : EuclideanSpace ℝ (Fin n)) (ε : ℝ), 0 < ε → ReachApprox 𝓕 T I A B C D v₀ 0 ε

/-- Exact null controllability from every deterministic initial state. -/
def ENC : Prop := ∀ v₀ : EuclideanSpace ℝ (Fin n), ReachExact 𝓕 T I A B C D v₀ 0

/-- Exact controllability to every square-integrable terminal target. -/
def EC : Prop := ∀ (v₀ : EuclideanSpace ℝ (Fin n)) (η : Lp (EuclideanSpace ℝ (Fin n)) 2 μ),
  AEStronglyMeasurable[𝓕 T] η μ → ReachExact 𝓕 T I A B C D v₀ η
end Properties

end LinearStochastic.Palomar

namespace LinearStochastic.Palomar
variable {Ω : Type*} [mΩ : MeasurableSpace Ω] {μ : Measure Ω}
  [IsProbabilityMeasure μ] [μ.IsComplete] {n r m : ℕ}
  {W : Fin m → ℝ≥0 → Ω → ℝ} (hW : ∀ i, IsBrownianReal (W i) μ)
  (hWm : ∀ i t, Measurable (W i t)) (hInd : iIndepFun (fun i ω t => W i t ω) μ)

include hW hInd in
/-- Full stochastic controllability classification, with existence of the
standard Itô integrals proved as part of the result. The integral is specified
by its action on every bounded predictable step process, not by an opaque
controllability predicate. All four properties use ordinary progressive
controls and actual continuous S² solutions on the usual Brownian filtration. -/
theorem classification (hn : 0 < n) (hm : 0 < m) (T : ℝ≥0) (hT : 0 < T)
    (A : Matrix (Fin n) (Fin n) ℝ) (B : Matrix (Fin n) (Fin r) ℝ)
    (C : Fin m → Matrix (Fin n) (Fin n) ℝ) (D : Fin m → Matrix (Fin n) (Fin r) ℝ) :
    ∃ I : Fin m → Lp ℝ 2 (spacetime (usual (μ := μ) W hWm) μ T) →L[ℝ] Lp ℝ 2 μ,
      (∀ i, IsIto (usual (μ := μ) W hWm) (W i) T (I i)) ∧
      (AC (usual (μ := μ) W hWm) T I A B C D ↔ flag A B C D n = {0}) ∧
      (ANC (usual (μ := μ) W hWm) T I A B C D ↔ flag A B C D n = {0}) ∧
      (ENC (usual (μ := μ) W hWm) T I A B C D ↔ flag A B C D n = {0}) ∧
      (EC (usual (μ := μ) W hWm) T I A B C D ↔
        flag A B C D n = {0} ∧ (stack D).rank = m*n) := by
  sorry

include hW hInd in
/-- The step-process characterization fixes the Itô integral uniquely.
Consequently the integral witnesses in classification cannot change the
meaning of any controllability predicate. -/
theorem ito_unique (T : ℝ≥0) (i : Fin m)
    (I J : Lp ℝ 2 (spacetime (usual (μ := μ) W hWm) μ T) →L[ℝ] Lp ℝ 2 μ)
    (hI : IsIto (usual (μ := μ) W hWm) (W i) T I)
    (hJ : IsIto (usual (μ := μ) W hWm) (W i) T J) : I = J := by
  sorry

end LinearStochastic.Palomar
